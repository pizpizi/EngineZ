{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Build Dir",
            "type": "shell",
            "group": "build",
            "linux": {
                "command": "rm -rf build && cmake -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DENGINEZ_BUILD_EXAMPLES=ON"
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "group": "build",
            "windows": {
                "command": "cmake --build build  --config Debug -DCMAKE_EXPORT_COMPILE_COMMANDS; if ($LASTEXITCODE -eq 0) { build\\test.exe } else {Write-Host \"ERROR: build failed\" -ForegroundColor Red}"
            },
            "linux": {
                "command": "cmake --build build --config Debug"
            }
        },
        {
            "label": "Run",
            "type": "shell",
            "group": "test",
            "dependsOn": "Build",
            "linux": {
                "command": "./build/examples/main"
            }
        }
    ]
}
