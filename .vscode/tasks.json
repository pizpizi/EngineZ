    "version": "2.0.0",
    "tasks": [
        {
            "label": "echo",
            "type": "shell",
            "command": "echo Hello"
        },
        {
            "label": "Build and run",
            "type" : "shell",
            "group": "build",
            "command": "cmake --build build; ./build/test.exe"
        },
        {
            "label": "Build",
            "type" : "shell",
            "group": "build",
            "command": "cmake --build build"
        },
        {
            "label": "Clean Build and run",
            "type" : "shell",
            "group": "build",
            "command": "cmake --build build --clean-first; ./build/test.exe"
        }
    ]
}