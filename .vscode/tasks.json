{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and run",
            "type": "shell",
            "group": "build",
            "windows": {
                "command": "cmake --build build  --config Debug; if ($LASTEXITCODE -eq 0) { build\\test.exe } else {Write-Host \"ERROR: build failed\" -ForegroundColor Red}"
            },
            "linux": {
                "command": "cmake --build build  --config Debug && ./build/test"
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "group": "build",
            "windows": {
                "command": "cmake --build build  --config Debug"
            },
            "linux": {
                "command": "cmake --build build --config Debug"
            }
        },
        {
            "label": "Clean Build and run",
            "type": "shell",
            "group": "build",
            "windows": {
                "command": "cmake --build build --clean-first  --config Debug; build\\test.exe"
            },
            "linux": {
                "command": "cmake --build build --clean-first  --config Debug && ./build/test"
            }
        }
    ]
}
