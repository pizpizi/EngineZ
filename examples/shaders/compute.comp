#version 450 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;


layout (set = 0, binding = 0) uniform InputBlock {
    mat4 A;
    mat4 B;
} inputData;

layout (set = 0, binding = 1) buffer OutputBlock {
    mat4 C;
} outputData;

void main() {
    outputData.C = inputData.A + inputData.B;
}