#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InputA {
    float A[2];
    float B[2];
};
layout(std430, binding = 2) writeonly buffer InputC {
    float C[2];
};

layout(push_constant) uniform PushConstants {
    uint size;
} pc;

void main() {
    uint x = gl_GlobalInvocationID.x;
    if (x < pc.size) {
        C[x] = A[x] + B[x];
    }
}
