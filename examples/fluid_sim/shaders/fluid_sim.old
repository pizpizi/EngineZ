#version 460

layout(local_size_x = 16, local_size_y = 16) in;

// Storage images (binding points matching pipeline layout)
layout(set = 0, binding = 0, r32f) uniform image2D pressure;
layout(set = 0, binding = 1, r32f) uniform image2D velocityX;
layout(set = 0, binding = 5, r32f) uniform image2D oldVelocityX;
layout(set = 0, binding = 2, r32f) uniform image2D velocityY;
layout(set = 0, binding = 6, r32f) uniform image2D oldVelocityY;
layout(set = 0, binding = 4, rgba8) uniform image2D smoke;
layout(set = 0, binding = 7, rgba8) uniform image2D oldSmoke;

layout(set = 0, binding = 3, rgba8) uniform writeonly image2D drawImage;

const uint VISUALIZE_PRESSURE = 0u;
const uint VISUALIZE_VELOCITY = 1u;
const uint VISUALIZE_DIVERGENCE = 2u;
const uint VISUALIZE_SMOKE = 3u;

const uint BRUSH_SMOKE = 0u;
const uint BRUSH_PRESSURE = 1u;

layout(push_constant) uniform Constants {
    float deltaTime;
    float density;
    vec2 brushPos;
    int redBlackIdx;
    float brushSize;
    ivec2 simBounds;
    bool brushDown;
    uint brushType;
    uint visType;
    float visScale;
} constants;

float getDivergence(ivec2 cord) {
    float u_right = imageLoad(velocityX, ivec2(cord.x + 1, cord.y)).x;
    float u_left = imageLoad(velocityX, cord).x;
    float v_down = imageLoad(velocityY, ivec2(cord.x, cord.y + 1)).x;
    float v_up = imageLoad(velocityY, cord).x;

    return (u_right - u_left) + (v_up - v_down);
}

float sampleVelocity(readonly image2D image, vec2 pos, vec2 offset) {
    pos -= offset;
    
    ivec2 topLeftCoord = ivec2(floor(pos));
    ivec2 topRightCoord = ivec2(topLeftCoord.x + 1, topLeftCoord.y);
    ivec2 bottomLeftCoord = ivec2(topLeftCoord.x, topLeftCoord.y + 1);
    ivec2 bottomRightCoord = ivec2(topLeftCoord.x + 1, topLeftCoord.y + 1);

    pos = fract(pos);

    float topLeftV     = ((topLeftCoord.x >= 0 && topLeftCoord.x < constants.simBounds.x + 1) &&
                        (topLeftCoord.y >= 0 && topLeftCoord.y < constants.simBounds.y + 1)) ? 
                        imageLoad(image, topLeftCoord).x : 0.0;
    float topRightV    = ((topRightCoord.x >= 0 && topRightCoord.x < constants.simBounds.x + 1) &&
                        (topRightCoord.y >= 0 && topRightCoord.y < constants.simBounds.y + 1)) ?
                        imageLoad(image, topRightCoord).x : 0.0;
    float bottomLeftV  = ((bottomLeftCoord.x >= 0 && bottomLeftCoord.x < constants.simBounds.x + 1) &&
                        (bottomLeftCoord.y >= 0 && bottomLeftCoord.y < constants.simBounds.y + 1)) ?
                        imageLoad(image, bottomLeftCoord).x : 0.0;
    float bottomRightV = ((bottomRightCoord.x >= 0 && bottomRightCoord.x < constants.simBounds.x + 1) &&
                        (bottomRightCoord.y >= 0 && bottomRightCoord.y < constants.simBounds.y + 1)) ?
                        imageLoad(image, bottomRightCoord).x : 0.0;

    return pos.x * (topRightV * (1-pos.y) + bottomRightV * pos.y) + (1-pos.x) * (topLeftV * (1-pos.y) + bottomLeftV * pos.y);
}

float sampleProperty(image2D image, vec2 pos, vec2 offset) {
    pos -= offset;
    
    ivec2 topLeftCoord = ivec2(floor(pos));
    ivec2 topRightCoord = ivec2(topLeftCoord.x + 1, topLeftCoord.y);
    ivec2 bottomLeftCoord = ivec2(topLeftCoord.x, topLeftCoord.y + 1);
    ivec2 bottomRightCoord = ivec2(topLeftCoord.x + 1, topLeftCoord.y + 1);

    pos = fract(pos);

    float topLeftV     = ((topLeftCoord.x >= 0 && topLeftCoord.x < constants.simBounds.x) &&
                        (topLeftCoord.y >= 0 && topLeftCoord.y < constants.simBounds.y)) ? 
                        imageLoad(image, topLeftCoord).x : 0.0;
    float topRightV    = ((topRightCoord.x >= 0 && topRightCoord.x < constants.simBounds.x) &&
                        (topRightCoord.y >= 0 && topRightCoord.y < constants.simBounds.y)) ?
                        imageLoad(image, topRightCoord).x : 0.0;
    float bottomLeftV  = ((bottomLeftCoord.x >= 0 && bottomLeftCoord.x < constants.simBounds.x) &&
                        (bottomLeftCoord.y >= 0 && bottomLeftCoord.y < constants.simBounds.y)) ?
                        imageLoad(image, bottomLeftCoord).x : 0.0;
    float bottomRightV = ((bottomRightCoord.x >= 0 && bottomRightCoord.x < constants.simBounds.x) &&
                        (bottomRightCoord.y >= 0 && bottomRightCoord.y < constants.simBounds.y)) ?
                        imageLoad(image, bottomRightCoord).x : 0.0;

    return pos.x * (topRightV * (1-pos.y) + bottomRightV * pos.y) + (1-pos.x) * (topLeftV * (1-pos.y) + bottomLeftV * pos.y);
}

#ifdef KERNEL_BRUSH
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= constants.simBounds.x || coord.y >= constants.simBounds.y)
        return;

    if (constants.brushDown && length(vec2(coord) - constants.brushPos) <= constants.brushSize) {
        switch (constants.brushType) {
            case BRUSH_PRESSURE:
            {
                imageStore(pressure, coord, vec4(1.0, 0.0, 0.0, 0.0));
                break;
            }
            case BRUSH_SMOKE:
            {
                imageStore(smoke, coord, vec4(1.0, 1.0, 1.0, 0.0));
                break;
            }
        }
    }
}
#endif

#ifdef KERNEL_ADVECT
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= constants.simBounds.x || coord.y >= constants.simBounds.y)
        return;

    vec2 leftEdgePos = vec2(coord.x, coord.y + 0.5);
    vec2 leftEdgeVelocity = vec2(sampleVelocity(oldVelocityX, leftEdgePos, vec2(0, 0.5)), sampleVelocity(oldVelocityY, leftEdgePos, vec2(0.5, 0)));
    vec2 leftEdgePrevPos = leftEdgePos - constants.deltaTime * leftEdgeVelocity;
    imageStore(velocityX, coord, vec4(sampleVelocity(oldVelocityX, leftEdgePrevPos, vec2(0, 0.5)), 0.0, 0.0, 0.0));

    vec2 topEdgePos = vec2(coord.x + 0.5, coord.y);
    vec2 topEdgeVelocity = vec2(sampleVelocity(oldVelocityX, topEdgePos, vec2(0, 0.5)), sampleVelocity(oldVelocityY, topEdgePos, vec2(0.5, 0)));
    vec2 topEdgePrevPos = topEdgePos - constants.deltaTime * topEdgeVelocity;
    imageStore(velocityY, coord, vec4(sampleVelocity(oldVelocityY, topEdgePrevPos, vec2(0, 0.5)), 0.0, 0.0, 0.0));

    vec2 centerPos = vec2(coord.x + 0.5, coord.y + 0.5);
    vec2 centerVelocity = vec2(sampleVelocity(oldVelocityX, centerPos, vec2(0, 0.5)), sampleVelocity(oldVelocityY, centerPos, vec2(0.5, 0)));
    vec2 centerPrevPos = centerPos - constants.deltaTime * centerVelocity;
    imageStore(smoke, coord, vec4(sampleProperty(oldSmoke, centerPrevPos, vec2(0, 0.5)), 0.0, 0.0, 0.0));
}
#endif

#ifdef KERNEL_PROJECT
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= constants.simBounds.x || coord.y >= constants.simBounds.y || ((coord.x + coord.y) % 2 != constants.redBlackIdx))
        return;

    bool leftExist  = (coord.x != 0);
    bool rightExist = (coord.x != constants.simBounds.x - 1);
    bool upExist    = (coord.y != 0);
    bool downExist  = (coord.y != constants.simBounds.y - 1);

    int neighbourNum = int(leftExist) + int(rightExist) + int(upExist) + int(downExist);
    if (neighbourNum == 0) return;

    float pCenter = imageLoad(pressure, coord).x;

    float pDown  = downExist  ? imageLoad(pressure, ivec2(coord.x, coord.y + 1)).x : pCenter;
    float pUp    = upExist    ? imageLoad(pressure, ivec2(coord.x, coord.y - 1)).x : pCenter;
    float pRight = rightExist ? imageLoad(pressure, ivec2(coord.x + 1, coord.y)).x : pCenter;
    float pLeft  = leftExist  ? imageLoad(pressure, ivec2(coord.x - 1, coord.y)).x : pCenter;

    float uLeft   = leftExist  ? imageLoad(velocityX, coord).x               : 0.0;
    float uRight  = rightExist ? imageLoad(velocityX, coord + ivec2(1, 0)).x : 0.0;
    float uUp     = upExist    ? imageLoad(velocityY, coord).x               : 0.0;
    float uDown   = downExist  ? imageLoad(velocityY, coord + ivec2(0, 1)).x : 0.0;

    float newPressure = (-constants.density / constants.deltaTime * (uRight - uLeft + uUp - uDown) + pDown + pLeft + pRight + pUp) / float(neighbourNum);

    imageStore(pressure, coord, vec4(newPressure, 0.0, 0.0, 0.0));
}
#endif

#ifdef KERNEL_UPDATE_VELOCITIES
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= constants.simBounds.x || coord.y >= constants.simBounds.y)
        return;

    bool leftExist  = (coord.x != 0);
    bool rightExist = (coord.x != constants.simBounds.x - 1);
    bool upExist    = (coord.y != 0);
    bool downExist  = (coord.y != constants.simBounds.y - 1);

    float pCenter = imageLoad(pressure, coord).x;

    float pDown  = downExist  ? imageLoad(pressure, ivec2(coord.x, coord.y + 1)).x : pCenter;
    float pUp    = upExist    ? imageLoad(pressure, ivec2(coord.x, coord.y - 1)).x : pCenter;
    float pRight = rightExist ? imageLoad(pressure, ivec2(coord.x + 1, coord.y)).x : pCenter;
    float pLeft  = leftExist  ? imageLoad(pressure, ivec2(coord.x - 1, coord.y)).x : pCenter;

    float uLeft   = leftExist  ? imageLoad(velocityX, coord).x : 0.0;
    float uUp     = upExist    ? imageLoad(velocityY, coord).x : 0.0;

    float uLeftNew   = uLeft - (constants.deltaTime / constants.density) * (pCenter - pLeft);
    float uUpNew     = uUp - (constants.deltaTime / constants.density) * (pUp - pCenter);

    imageStore(velocityX, coord, vec4(uLeftNew, 0.0, 0.0, 0.0));
    imageStore(velocityY, coord, vec4(uUpNew, 0.0, 0.0, 0.0));

    if(coord.x == constants.simBounds.x - 1) {
        float uRight  = rightExist ? imageLoad(velocityX, coord + ivec2(1, 0)).x : 0.0;
        float uRightNew  = rightExist ? imageLoad(velocityX, coord + ivec2(1, 0)).x : 0.0;
        imageStore(velocityX, ivec2(coord.x + 1, coord.y), vec4(uRightNew, 0.0, 0.0, 0.0));
    }
    if(coord.y == constants.simBounds.y - 1) {
        float uDown   = downExist  ? imageLoad(velocityY, coord + ivec2(0, 1)).x : 0.0;
        float uDownNew   = downExist  ? imageLoad(velocityY, coord + ivec2(0, 1)).x : 0.0;
        imageStore(velocityY, ivec2(coord.x, coord.y + 1), vec4(uDownNew, 0.0, 0.0, 0.0));
    }
}
#endif

#ifdef KERNEL_VISUALIZE
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= constants.simBounds.x || coord.y >= constants.simBounds.y)
        return;

    vec4 outColor = vec4(0.0, 0.0, 0.0, 1.0);

    switch (constants.visType) {
        case VISUALIZE_PRESSURE:
        {
            float p = imageLoad(pressure, coord).r / constants.visScale;
            outColor = (p >= 0.0) ? vec4(p, 0.0, 0.0, 1.0) : vec4(0.0, 0.0, -p, 1.0);
            break;
        }
        case VISUALIZE_VELOCITY:
        {
            float u = imageLoad(velocityX, coord).r;
            float v = imageLoad(velocityY, coord).r;
            float speed = length(vec2(u, v)) / constants.visScale;
            outColor = vec4(speed, speed * 0.5, 0.0, 1.0);
            break;
        }
        case VISUALIZE_DIVERGENCE:
        {
            float uLeft   = imageLoad(velocityX, coord).x;
            float uRight  = imageLoad(velocityX, coord + ivec2(1, 0)).x;
            float uUp     = imageLoad(velocityY, coord).x;
            float uDown   = imageLoad(velocityY, coord + ivec2(0, 1)).x;

            float divergence = (uRight - uLeft + uUp - uDown) / constants.visScale;
            outColor = (divergence >= 0.0) ? vec4(divergence, 0.0, 0.0, 1.0) : vec4(0.0, 0.0, -divergence, 1.0);
            break;
        }
        case VISUALIZE_SMOKE:
        {
            outColor = vec4(imageLoad(smoke, coord).xyz / constants.visScale, 0.0);
            break;
        }
    }

    imageStore(drawImage, coord, outColor);
}
#endif